{
  "name": "becommerce-mysql",
  "config": {
    "connector.class": "io.debezium.connector.mysql.MySqlConnector",
    "tasks.max": "1",
    "database.hostname": "mysql",
    "database.port": "3306",
    "database.user": "debezium",
    "database.password": "debezium-local-only",
    "database.server.id": "5401",
    "topic.prefix": "bcd",
    "database.include.list": "becommerce",
    "table.include.list": "becommerce.sellers,becommerce.products,becommerce.orders,becommerce.order_items,becommerce.payments,becommerce.payment_history,becommerce.internal_records,becommerce.settlement_items,becommerce.settlements",
    "schema.history.internal.kafka.bootstrap.servers": "kafka1:9092,kafka2:9092,kafka3:9092",
    "schema.history.internal.kafka.topic": "_schema_history.becommerce",
    "snapshot.mode": "initial",
    "include.schema.changes": "false",
    "heartbeat.interval.ms": "10000",
    "tombstones.on.delete": "true"
  }
}
